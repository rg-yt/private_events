<h1><%= @user.email %> created events</h1>
<ul>
    <% @user.events.each do |event| %>
        <li>
            <%= event.title %>
        </li>
    <% end %>
</ul>
<h1>Attended events</h1>
<ul>
    <% @user.attended_events.each do |event| %>
        <li>
            <%= event.title %>
        </li>
    <% end %>
</ul>
